# Formula1-AI Environment Configuration
# Copy this to .env and fill in your values

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Dashboard
DASH_HOST=0.0.0.0
DASH_PORT=8050

# Database
DUCKDB_PATH=data/formula1_ai.duckdb
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=4

# Data sources
ERGAST_BASE_URL=https://api.jolpi.ca/ergast/f1
OPENF1_BASE_URL=https://api.openf1.org/v1
FASTF1_CACHE_DIR=data/raw/fastf1_cache
ERGAST_SEASON_START=2018
ERGAST_SEASON_END=2024

# ML Tracking
MLFLOW_TRACKING_URI=mlruns
MLFLOW_EXPERIMENT_NAME=Formula1-AI

# HPO
OPTUNA_N_TRIALS=100
OPTUNA_TIMEOUT_SECONDS=3600

# Models
MODELS_DIR=data/models
RANDOM_STATE=42

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
